@page "/admin/citas"
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@using COMMON.Entidades
@using Microsoft.JSInterop

<link href="css/admin-citas.css" rel="stylesheet" />

@if (isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 100vh; flex-direction: column;">
        <div class="spinner"></div>
        <p>Verificando autenticación...</p>
    </div>
}
else if (!isAuthenticated)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 100vh; flex-direction: column;">
        <p>Redirigiendo al login...</p>
    </div>
}
else
{
<div class="admin-citas-container">
    <div class="header-section">
        <div>
            <h1 style="margin: 0;">📅 Gestión de Citas</h1>
            <p style="margin: 5px 0 0 0;">Panel de administración</p>
        </div>
        <div class="header-actions">
            <button type="button" class="nav-btn" onclick="window.location.href='/admin'">
                ← Volver al Panel
              </button>
            <button type="button" class="nav-btn" onclick="window.refreshCitas ? window.refreshCitas() : location.reload()">
                🔄 Actualizar
             </button>
            <button type="button" class="nav-btn" onclick="logout()">
                        🚪 Cerrar Sesión
            </button>
        </div>
    </div>

    @if (isLoadingCitas)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Cargando citas...</p>
        </div>
    }
    else
    {

        <div class="calendar-controls">
            <div class="month-navigation">
                <button type="button" class="nav-btn" onclick="window.previousMonth ? window.previousMonth() : alert('Cargando...')">‹</button>
                <span class="current-month" id="currentMonth">@currentDate.ToString("MMMM yyyy")</span>
                <button type="button" class="nav-btn" onclick="window.nextMonth ? window.nextMonth() : alert('Cargando...')">›</button>
            </div>
            <div class="view-toggles">
                <button type="button" class="view-btn active" id="calendarViewBtn" onclick="window.switchView ? window.switchView('calendar') : alert('Cargando...')">
                    📅 Calendario
                </button>
                <button type="button" class="view-btn" id="listViewBtn" onclick="window.switchView ? window.switchView('list') : alert('Cargando...')">
                    📋 Lista
                </button>
            </div>
        </div>

        <div id="calendarView" class="calendar-grid">
            <div class="calendar-header">
                <div>Domingo</div>
                <div>Lunes</div>
                <div>Martes</div>
                <div>Miércoles</div>
                <div>Jueves</div>
                <div>Viernes</div>
                <div>Sábado</div>
            </div>
            <div class="calendar-body" id="calendarBody">
                <div style="grid-column: 1 / -1; text-align: center; padding: 40px;">
                    <p>Cargando calendario...</p>
                </div>
            </div>
        </div>

        <div id="listView" class="list-view" style="display: none;">
            <div style="text-align: center; padding: 40px;">
                <p>Cargando lista...</p>
            </div>
        </div>
    }
</div>
}

<!-- Modal de detalles -->
<div class="modal-overlay" id="citaModal" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Detalles de la Cita</h2>
            <button type="button" class="close-modal" onclick="window.closeCitaModal()">×</button>
        </div>

        <div id="modalContent">
            <!-- Se llena dinámicamente con JS -->
        </div>

        <div class="notes-section">
            <h3>Notas del Administrador</h3>
            <textarea class="notes-textarea" id="adminNotes" placeholder="Agregar notas internas..."></textarea>
        </div>

        <div class="modal-actions" id="modalActions">
            <!-- Se llenan dinámicamente con JS -->
        </div>
    </div>
</div>

@code {
    private List<Cita> todasCitas = new();
    private DateTime currentDate = DateTime.Now;
    private bool isLoading = true;
    private bool isLoadingCitas = false;
    private bool scriptLoaded = false;
    private bool isAuthenticated = false;
    private bool dataInitialized = false;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("🔐 AdminCitas: Iniciando...");
        // NO cargar datos aquí, esperar a OnAfterRenderAsync
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // PASO 1: Verificar autenticación
                Console.WriteLine("🔐 Verificando autenticación...");
                isAuthenticated = await CheckAuthentication();
                
                if (!isAuthenticated)
                {
                    Console.WriteLine("❌ No autenticado, redirigiendo...");
                    isLoading = false;
                    StateHasChanged();
                    await Task.Delay(500);
                    Navigation.NavigateTo("/login", forceLoad: true);
                    return;
                }
                
                Console.WriteLine("✅ Autenticado correctamente");
                isLoading = false;
                StateHasChanged();
                
                // PASO 2: Cargar datos PRIMERO
                await LoadCitas();
                
                await Task.Delay(200);

                // PASO 3: Cargar script JavaScript
                if (!scriptLoaded)
                {
                    scriptLoaded = true;
                    Console.WriteLine("📜 Cargando admin-citas.js...");

                    await JSRuntime.InvokeVoidAsync("eval", @"
                        (function() {
                            if (window.adminCitasScriptLoaded) {
                                console.log('✅ Script ya cargado');
                                return;
                            }
                            
                            window.adminCitasScriptLoaded = true;
                            
                            const script = document.createElement('script');
                            script.src = 'JS/admin-citas.js?v=' + Date.now();
                            script.async = false;
                            
                            script.onload = () => {
                                console.log('✅ admin-citas.js cargado');
                            };
                            
                            script.onerror = (e) => {
                                console.error('❌ Error cargando script:', e);
                            };
                            
                            document.head.appendChild(script);
                        })();
                    ");

                    // PASO 4: Esperar a que el script esté listo
                    int attempts = 0;
                    bool scriptReady = false;
                    
                    while (attempts < 20 && !scriptReady)
                    {
                        await Task.Delay(100);
                        
                        try
                        {
                            scriptReady = await JSRuntime.InvokeAsync<bool>("eval", @"
                                window.adminCitasInitialized === true &&
                                typeof window.initAdminCitas === 'function'
                            ");
                        }
                        catch
                        {
                            scriptReady = false;
                        }
                        
                        attempts++;
                        
                        if (scriptReady)
                        {
                            Console.WriteLine($"✅ Script listo después de {attempts * 100}ms");
                            break;
                        }
                    }
                    
                    if (!scriptReady)
                    {
                        Console.WriteLine("⚠️ Timeout esperando script. Forzando inicialización...");
                    }

                    // PASO 5: Pasar datos a JavaScript
                    await InitializeJavaScriptData();

                    Console.WriteLine("✅ Sistema de citas inicializado");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"❌ Error en OnAfterRenderAsync: {ex.Message}");
                Console.WriteLine($"Stack: {ex.StackTrace}");
            }
        }
    }

    private async Task InitializeJavaScriptData()
    {
        if (dataInitialized) return;
        
        try
        {
            var citasJson = System.Text.Json.JsonSerializer.Serialize(todasCitas, new System.Text.Json.JsonSerializerOptions
            {
                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
            });
            
            var currentDateStr = currentDate.ToString("yyyy-MM-ddTHH:mm:ss");
            
            Console.WriteLine($"📊 Pasando {todasCitas.Count} citas a JavaScript...");
            Console.WriteLine($"📝 JSON preview: {citasJson.Substring(0, Math.Min(200, citasJson.Length))}...");
            
            await JSRuntime.InvokeVoidAsync("eval", $@"
                console.log('📊 Configurando datos globales...');
                window.citasData = {citasJson};
                window.currentDate = new Date('{currentDateStr}');
                console.log('✅ Datos configurados:', {{
                    totalCitas: window.citasData.length,
                    primeraFecha: window.citasData.length > 0 ? window.citasData[0].fechaHora : 'ninguna',
                    fecha: window.currentDate.toISOString()
                }});
            ");

            await Task.Delay(200);
            
            await JSRuntime.InvokeVoidAsync("eval", @"
                console.log('🚀 Inicializando interfaz...');
                if (typeof window.initAdminCitas === 'function') {
                    window.initAdminCitas();
                    console.log('✅ Interfaz inicializada correctamente');
                } else {
                    console.warn('⚠️ initAdminCitas no disponible, renderizando manualmente...');
                    if (typeof window.renderCurrentView === 'function') {
                        window.renderCurrentView();
                    } else if (window.citasData) {
                        console.log('🔧 Intentando inicialización de emergencia...');
                        window.currentView = 'calendar';
                        setTimeout(() => {
                            if (typeof window.initAdminCitas === 'function') {
                                window.initAdminCitas();
                            }
                        }, 500);
                    }
                }
            ");
            
            dataInitialized = true;
            Console.WriteLine("✅ Datos JavaScript inicializados");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error inicializando datos JS: {ex.Message}");
        }
    }

    private async Task<bool> CheckAuthentication()
    {
        try
        {
            Console.WriteLine("🔍 Verificando sesión...");
            
            var isValid = await JSRuntime.InvokeAsync<bool>("eval", @"
                (function() {
                    try {
                        const session = JSON.parse(localStorage.getItem('adminSession') || 'null');
                        if (!session) {
                            console.log('❌ No hay sesión');
                            return false;
                        }
                        
                        const now = Date.now();
                        const isValid = session.expiresAt && session.expiresAt > now;
                        
                        console.log('[Auth] Sesión válida:', isValid);
                        
                        if (isValid) {
                            window.adminSession = session;
                        }
                        
                        return isValid;
                    } catch(e) {
                        console.error('[Auth] Error:', e);
                        return false;
                    }
                })()
            ");
            
            Console.WriteLine(isValid ? "✅ Sesión válida" : "❌ Sesión inválida");
            return isValid;
            
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error verificando autenticación: {ex.Message}");
            return false;
        }
    }

    private async Task LoadCitas()
    {
        isLoadingCitas = true;
        StateHasChanged();
        
        try
        {
            var apiUrl = "http://ConsultoriaIntegralSC.somee.com/api/Cita";
            Console.WriteLine($"📡 Cargando citas desde: {apiUrl}");
            
            var response = await Http.GetAsync(apiUrl);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<List<Cita>>();
                todasCitas = result ?? new List<Cita>();
                Console.WriteLine($"✅ {todasCitas.Count} citas cargadas en C#");
                
                // DEBUG: Mostrar primeras 3 citas
                foreach (var cita in todasCitas.Take(3))
                {
                    Console.WriteLine($"   📋 ID: {cita.Id}, Nombre: {cita.NombreCompleto}, Fecha: {cita.FechaHora:yyyy-MM-dd HH:mm}, Estado: {cita.Estado}");
                }
            }
            else
            {
                Console.WriteLine($"❌ Error HTTP: {response.StatusCode}");
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"❌ Contenido del error: {errorContent}");
                todasCitas = new List<Cita>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error cargando citas: {ex.Message}");
            Console.WriteLine($"❌ Stack: {ex.StackTrace}");
            todasCitas = new List<Cita>();
        }
        finally
        {
            isLoadingCitas = false;
            StateHasChanged();
        }
    }
}