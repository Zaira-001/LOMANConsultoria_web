@page "/contacto"
@inject IJSRuntime JSRuntime

<link href="css/contacto.css" rel="stylesheet" />

<div class="nosotros-container">
    <header class="hero-section">
        <h1 class="main-title">CONTÁCTANOS</h1>
        <p class="description">
            Estamos aquí para ayudarte a transformar tu negocio.
        </p>
    </header>

    <div class="contact-info">
        <div class="contact-item">
            <div class="contact-icon phone-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <div class="contact-details">
                <h3>Teléfono</h3>
                <div class="phone-numbers">
                    <span>56-5964-4304</span>
                </div>
            </div>
        </div>

        <div class="contact-item">
            <div class="contact-icon email-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <div class="contact-details">
                <h3>Email</h3>
                <span>lomanconsultoria2025@gmail.com</span>

            </div>
        </div>

        <div class="contact-item">
            <div class="contact-icon location-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <div class="contact-details">
                <h3>Ubicación</h3>
                <p class="location-city">Ciudad de México</p>
                <p class="work-info">Trabajo 90% campo, 10% oficina</p>
            </div>
        </div>
    </div>

    <!-- SECCIÓN DE CONTACTO -->
    <div class="contact-section">
        <div class="contact-container">
            <div class="contact-content fade-in">
                <div class="form-column">
                    <h2 class="contact-title">Envíanos un mensaje</h2>
                    <p class="contact-subtitle">Déjanos tus datos y te responderemos a la brevedad</p>

                    <!-- Mensaje de estado -->
                    <div id="formMessage" class="form-message" style="display: none;"></div>

                    <!-- CAMBIO CRÍTICO: Agregar action="javascript:void(0);" y onsubmit="return false;" -->
                    <form id="contactForm" class="contact-form" action="javascript:void(0);" onsubmit="return false;">
                        <div class="field-container">
                            <input type="text" id="nombre" name="nombre" class="form-input" placeholder="Nombre*" required>
                            <div class="error-message" id="nombreError"></div>
                        </div>

                        <div class="form-group">
                            <div class="field-container">
                                <input type="email" id="correo" name="correo" class="form-input" placeholder="Correo*" required>
                                <div class="error-message" id="correoError"></div>
                            </div>
                            <div class="field-container">
                                <input type="tel" id="telefono" name="telefono" class="form-input" placeholder="Teléfono*" required>
                                <div class="error-message" id="telefonoError"></div>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="field-container">
                                <select id="prioridad" name="prioridad" class="form-select" required>
                                    <option value="">Selecciona la prioridad*</option>
                                    <option value="Baja">Baja</option>
                                    <option value="Media">Media</option>
                                    <option value="Alta">Alta</option>
                                </select>
                                <div class="error-message" id="prioridadError"></div>
                            </div>
                            <div class="field-container">
                                <select id="tipoConsulta" name="tipoConsulta" class="form-select">
                                    <option value="">Tipo de consulta</option>
                                    <option value="Consulta General">Consulta General</option>
                                    <option value="Servicios Administrativos">Servicios Administrativos</option>
                                    <option value="Servicios Fiscales">Servicios Fiscales</option>
                                    <option value="Servicios Legales">Servicios Legales</option>
                                    <option value="Facturación 4.0">Facturación 4.0</option>
                                    <option value="Servicios Financieros">Servicios Financieros</option>
                                    <option value="Incubadora de Negocios">Incubadora de Negocios</option>
                                    <option value="Financiamiento PYME">Financiamiento PYME</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="field-container">
                                <input type="text" id="nombreEmpresa" name="nombreEmpresa" class="form-input" placeholder="Nombre de la empresa (opcional)">
                            </div>
                            <div class="field-container">
                                <select id="tamanoEmpresa" name="tamanoEmpresa" class="form-select">
                                    <option value="">Tamaño de empresa</option>
                                    <option value="Pequeña">Pequeña (1-50 empleados)</option>
                                    <option value="Mediana">Mediana (51-250 empleados)</option>
                                    <option value="Grande">Grande (250+ empleados)</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group full-width">
                            <div class="field-container">
                                <textarea id="mensaje" name="mensaje" class="form-textarea" placeholder="Mensaje*" required></textarea>
                                <div class="error-message" id="mensajeError"></div>
                            </div>
                        </div>

                        <!-- CAMBIO: Cambiar type="submit" por type="button" -->
                        <button type="button" class="submit-btn" id="submitBtn">
                            <span id="btnText">Enviar</span>
                        </button>
                    </form>
                </div>
            </div>

            <div class="cta-section">
                <h2>¿Listo para hacer crecer tu negocio?</h2>
                <p class="cta-subtitle">Los grandes logros comienzan con una decisión. Decide hoy, crece mañana con nuestro crédito.</p>

                <div class="action-buttons">
                    <button class="btn-primary" @onclick="LlamarAhora">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        Llamar ahora
                    </button>

                    <button class="btn-secondary" @onclick="EnviarMensajeWhatsApp">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.595z" fill="currentColor" />
                        </svg>
                        Enviar WhatsApp
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FOOTER -->
<footer class="footer">

    <!-- Línea inferior del copyright -->
    <div class="footer-bottom">
        © 2025 Consultoría Integral SC Todos los derechos reservados.
    </div>
</footer>

<script src="js/simple-contact-form.js"></script>

@code {
    // Configuración de contacto
    private readonly string phoneNumber = "5659644304";
    private readonly string whatsappNumber = "525659644304"; // Agregar código de país para WhatsApp

    private async Task LlamarAhora()
    {
        try
        {
            var telUri = $"tel:{phoneNumber}";
            await JSRuntime.InvokeVoidAsync("open", telUri, "_self");
        }
        catch (Exception ex)
        {
            // Fallback: mostrar el número en caso de error
            await JSRuntime.InvokeVoidAsync("alert", $"Puedes llamarnos al: {phoneNumber}");
            Console.WriteLine($"Error al realizar llamada: {ex.Message}");
        }
    }

    private async Task EnviarMensajeWhatsApp()
    {
        try
        {
            // Mensaje predefinido para WhatsApp
            var mensaje = "Hola, me interesa conocer más sobre sus servicios de consultoría. ¿Podrían proporcionarme más información?";
            var mensajeCodificado = Uri.EscapeDataString(mensaje);

            // URL de WhatsApp con el mensaje predefinido
            var whatsappUri = $"https://wa.me/{whatsappNumber}?text={mensajeCodificado}";

            await JSRuntime.InvokeVoidAsync("open", whatsappUri, "_blank");
        }
        catch (Exception ex)
        {
            // Fallback: mostrar el número en caso de error
            await JSRuntime.InvokeVoidAsync("alert", $"Puedes escribirnos por WhatsApp al: +52 {phoneNumber}");
            Console.WriteLine($"Error al abrir WhatsApp: {ex.Message}");
        }
    }

    // Método adicional para enviar mensaje personalizado (opcional)
    private async Task EnviarMensajePersonalizado(string mensajeCustom)
    {
        try
        {
            var mensajeCodificado = Uri.EscapeDataString(mensajeCustom);
            var whatsappUri = $"https://wa.me/{whatsappNumber}?text={mensajeCodificado}";

            await JSRuntime.InvokeVoidAsync("open", whatsappUri, "_blank");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al enviar mensaje: {ex.Message}");
            Console.WriteLine($"Error al abrir WhatsApp con mensaje personalizado: {ex.Message}");
        }
    }
}