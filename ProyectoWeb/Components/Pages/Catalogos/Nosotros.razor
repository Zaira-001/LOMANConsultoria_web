    private async Task EnviarMensajeWhatsAppTrabajo(string jobTitle = "", string jobLevel = "", string jobArea = "")
    {
        try
        {
            string mensaje;

            if (!string.IsNullOrEmpty(jobTitle))
            {
                mensaje = $"Hola, me interesa la posición de *{jobTitle}* ({jobLevel}) en el área de {jobArea}. " +
                         "¿Podrían proporcionarme más información sobre los requisitos, el proceso de selección y los beneficios? " +
                         "Estoy muy interesado/a en formar parte de su equipo.";
            }
            else
            {
                mensaje = "Hola, me interesa conocer más sobre las oportunidades laborales disponibles en su empresa. " +
                         "¿Podrían proporcionarme información sobre las posiciones abiertas y el proceso de aplicación?";
            }

            var mensajeCodificado = Uri.EscapeDataString(mensaje);
            var whatsappUri = $"https://wa.me/{whatsappNumber}?text={mensajeCodificado}";

            await JSRuntime.InvokeVoidAsync("open", whatsappUri, "_blank");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al abrir WhatsApp: {ex.Message}");
            // No mostrar alert para evitar interrumpir la experiencia del usuario
        }
    }

    private async Task EnviarMensajeWhatsApp()
    {
        await EnviarMensajeWhatsAppTrabajo();
    }

    [JSInvokable]
    public async Task SendWhatsAppForJob(string jobTitle, string jobLevel, string jobArea)
    {
        try
        {
            await EnviarMensajeWhatsAppTrabajo(jobTitle, jobLevel, jobArea);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en SendWhatsAppForJob: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender && !isInitialized)
            {
                // Esperar un poco para que el DOM esté completamente cargado
                await Task.Delay(500);

                // Registrar el componente para JavaScript

                // Inicializar scripts específicos de la página
                await InitializePageScripts();

                isInitialized = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en OnAfterRenderAsync: {ex.Message}");
            // No propagar el error para evitar romper el circuito
        }
    }

    private async Task InitializePageScripts()
    {
        try
        {
            // Inicializar carrusel si existe
            await JSRuntime.InvokeVoidAsync("eval", @"
                if (typeof initializeCarousel === 'function') {
                    initializeCarousel();
                    console.log('Carrusel inicializado desde Blazor');
                }
            ");

            // Inicializar sección de empleos si existe
            await JSRuntime.InvokeVoidAsync("eval", @"
                if (typeof initializeJobsSection === 'function') {
                    initializeJobsSection();
                    console.log('Sección de empleos inicializada desde Blazor');
                }
            ");

            Console.WriteLine("Scripts de página inicializados correctamente");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error inicializando scripts: {ex.Message}");
        }
    }

    public void Dispose()
    {
        // Limpiar recursos si es necesario
        isInitialized = false;
    }

}

