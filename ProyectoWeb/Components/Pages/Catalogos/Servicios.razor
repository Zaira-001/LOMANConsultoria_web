@page "/servicios"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<link href="css/servicios.css" rel="stylesheet" />
<link href="css/servicios-modals.css" rel="stylesheet" />

<div class="nosotros-container">
    <header class="hero-section">
        <h1 class="main-title">NUESTROS SERVICIOS INTEGRALES</h1>
        <p class="description">
            Ofrecemos soluciones completas para el crecimiento y desarrollo de tu empresa.
        </p>

        <!-- Botones de servicios -->
        <div class="servicios-buttons">
            <div class="service-card @(selectedService == "administrativos" ? "active" : "")" @onclick="@(() => SelectService("administrativos"))">
                <div class="service-icon">
                    <img src="Iconos/edificios.png" alt="Administrativos" class="icon-img">
                </div>
                <span class="service-name">Trámites Administrativos</span>
            </div>

            <div class="service-card @(selectedService == "fiscales" ? "active" : "")" @onclick="@(() => SelectService("fiscales"))">
                <div class="service-icon">
                    <img src="Iconos/fiscal.png" alt="Fiscales" class="icon-img">
                </div>
                <span class="service-name">Servicios Fiscales</span>
            </div>

            <div class="service-card @(selectedService == "legales" ? "active" : "")" @onclick="@(() => SelectService("legales"))">
                <div class="service-icon">
                    <img src="Iconos/hoja.png" alt="Legales" class="icon-img">
                </div>
                <span class="service-name">Servicios Legales</span>
            </div>

            <div class="service-card @(selectedService == "facturacion" ? "active" : "")" @onclick="@(() => SelectService("facturacion"))">
                <div class="service-icon">
                    <img src="Iconos/factura.png" alt="Facturacion" class="icon-img">
                </div>
                <span class="service-name">Facturación 4.0</span>
            </div>

            <div class="service-card @(selectedService == "financieros" ? "active" : "")" @onclick="@(() => SelectService("financieros"))">
                <div class="service-icon">
                    <img src="Iconos/edificios.png" alt="Financieros" class="icon-img">
                </div>
                <span class="service-name">Servicios Financieros</span>
            </div>

            <div class="service-card @(selectedService == "incubadora" ? "active" : "")" @onclick="@(() => SelectService("incubadora"))">
                <div class="service-icon">
                    <img src="Iconos/edificios.png" alt="Incubadora" class="icon-img">
                </div>
                <span class="service-name">Incubadora de Negocios</span>
            </div>

            <div class="service-card @(selectedService == "financiamiento" ? "active" : "")" @onclick="@(() => SelectService("financiamiento"))">
                <div class="service-icon">
                    <img src="Iconos/edificios.png" alt="Financiamiento" class="icon-img">
                </div>
                <span class="service-name">Financiamiento PYME</span>
            </div>
        </div>
        
    </header>

    <!-- Sección de información del servicio seleccionado -->
    @if (!string.IsNullOrEmpty(selectedService))
    {
        <div class="service-info-container fade-in">
            <div class="service-detail">
                <div class="service-header">
                    <h2 class="service-title">@GetServiceTitle(selectedService)</h2>
                    <div class="service-meta">
                        <span class="delivery-time">⏱️ Tiempo: @GetDeliveryTime(selectedService)</span>
                        <span class="price-range">💰 Desde: @GetPriceRange(selectedService)</span>
                        <span class="experience">🏆 @GetExperience(selectedService) años de experiencia</span>
                    </div>
                </div>

                <div class="service-content">
                    <div class="service-description">
                        <p>@GetServiceDescription(selectedService)</p>
                    </div>

                    <div class="service-details-grid">
                        <div class="service-features">
                            <h3>Características del servicio</h3>
                            <ul>
                                @foreach (var feature in GetServiceFeatures(selectedService))
                                {
                                    <li>@feature</li>
                                }
                            </ul>
                        </div>
                        <div class="service-benefits">
                            <h3>Beneficios</h3>
                            <ul>
                                @foreach (var benefit in GetServiceBenefits(selectedService))
                                {
                                    <li>@benefit</li>
                                }
                            </ul>
                        </div>
                        <div class="service-requirements">
                            <h3>📋 Documentos útiles para el trámite</h3>
                            <ul>
                                @foreach (var requirement in GetRequirements(selectedService))
                                {
                                    <li>@requirement</li>
                                }
                            </ul>
                        </div>
                    </div>

                    <div class="service-guarantee">
                        <h3>🛡️ Nuestra Garantía</h3>
                        <p class="guarantee-text">@GetServiceGuarantee(selectedService)</p>
                    </div>
                </div>

                <div class="faq-section">
                    <h3>❓ Preguntas Frecuentes</h3>
                    <div class="faq-items">
                        @foreach (var faq in GetServiceFAQ(selectedService))
                        {
                            <div class="faq-item">
                                <button class="faq-question" @onclick="@(() => ToggleFAQ(faq.Key))">
                                    @faq.Key
                                    <span class="faq-arrow">@(openFAQs.Contains(faq.Key) ? "▼" : "▶")</span>
                                </button>
                                @if (openFAQs.Contains(faq.Key))
                                {
                                    <div class="faq-answer fade-in">@faq.Value</div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="service-actions">
                    <button class="btn-contact" @onclick="OpenContactModal">📞 Solicitar Información</button>
                    <button class="btn-quote" @onclick="OpenQuoteModal">📝 Cotizar Ahora</button>
                    <button class="btn-whatsapp" @onclick="OpenWhatsApp">💬 Chat WhatsApp</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="initial-state">
            <h3>👆 Selecciona un servicio para ver más información</h3>
            <p>Haz clic en cualquiera de nuestros servicios para conocer todos los detalles.</p>
        </div>
    }


    <!-- MODAL DE CONTACTO MEJORADO -->
    @if (showContactModal)
    {
        <div class="modal-overlay" @onclick="CloseContactModal">
            <div class="modal-content fade-in" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3>📞 Solicitar Información</h3>
                    <button type="button" class="modal-close" @onclick="CloseContactModal">×</button>
                </div>
                <div class="modal-body">
                    <div style="text-align: center; margin-bottom: 20px;">
                        <div style="font-size: 48px; margin-bottom: 10px;">📋</div>
                        <p style="font-size: 18px; font-weight: 600; color: #1f2937;">
                            ¿Te interesa nuestro servicio de
                        </p>
                        <p style="font-size: 20px; font-weight: 700; color: #667eea; margin-top: 5px;">
                            @GetServiceTitle(selectedService)?
                        </p>
                    </div>

                    <div class="info-box" style="background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%); padding: 20px; border-radius: 12px; margin: 20px 0;">
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
                            <span style="font-size: 24px;">📱</span>
                            <div>
                                <p style="margin: 0; font-size: 13px; color: #6b7280;">Llámanos directamente:</p>
                                <p style="margin: 0; font-size: 18px; font-weight: 700; color: #1f2937;">56-5964-4304</p>
                            </div>
                        </div>

                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
                            <span style="font-size: 24px;">📧</span>
                            <div>
                                <p style="margin: 0; font-size: 13px; color: #6b7280;">Escríbenos:</p>
                                <p style="margin: 0; font-size: 16px; font-weight: 600; color: #1f2937;">lomanconsultoria2025@gmail.com</p>
                            </div>
                        </div>

                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span style="font-size: 24px;">🕒</span>
                            <div>
                                <p style="margin: 0; font-size: 13px; color: #6b7280;">Horario de atención:</p>
                                <p style="margin: 0; font-size: 16px; font-weight: 600; color: #1f2937;">Lunes a Viernes 9:00 AM - 6:00 PM</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" @onclick="CloseContactModal">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- MODAL DE COTIZACIÓN MEJORADO -->
    @if (showQuoteModal)
    {
        <div class="modal-overlay" @onclick="HandleQuoteModalOutsideClick">
            <div class="modal-content fade-in" @onclick:stopPropagation="true" style="max-width: 600px;">
                <div class="modal-header">
                    <h3>📝 Solicitar Cotización</h3>
                    <button type="button" class="modal-close" @onclick="CloseQuoteModal" disabled="@isSubmitting">×</button>
                </div>

                @if (quoteSubmitted)
                {
                    <!-- MENSAJE DE ÉXITO -->
                    <div class="modal-body">
                        <div class="success-message">
                            <div style="font-size: 64px; margin-bottom: 20px;">✅</div>
                            <h3>¡Cotización Enviada Exitosamente!</h3>

                            <div style="background: #ecfdf5; padding: 20px; border-radius: 12px; margin: 25px 0; border-left: 4px solid #10b981;">
                                <p style="margin: 0 0 10px 0; color: #065f46; font-size: 16px;">
                                    <strong>📋 Servicio:</strong> @GetServiceTitle(selectedService)
                                </p>
                                <p style="margin: 0 0 10px 0; color: #065f46; font-size: 16px;">
                                    <strong>👤 Solicitante:</strong> @quoteForm.Name
                                </p>
                                <p style="margin: 0; color: #065f46; font-size: 16px;">
                                    <strong>📧 Email de confirmación enviado a:</strong><br>
                                    <span style="font-size: 18px; font-weight: 700; color: #667eea;">@quoteForm.Email</span>
                                </p>
                            </div>

                            <div style="background: #dbeafe; padding: 20px; border-radius: 12px; margin: 20px 0; border-left: 4px solid #3b82f6;">
                                <p style="margin: 0 0 8px 0; color: #1e40af; font-weight: 600;">
                                    ⏱️ ¿Qué sigue ahora?
                                </p>
                                <p style="margin: 0; color: #1e40af; font-size: 15px; line-height: 1.6;">
                                    Nuestro equipo revisará tu solicitud y te contactará en las próximas <strong>24 horas</strong> al número:
                                </p>
                                <p style="font-size: 20px; font-weight: 700; color: #667eea; margin: 10px 0 0 0;">
                                    📱 @quoteForm.Phone
                                </p>
                            </div>


                            <div style="background: #fef3c7; padding: 15px; border-radius: 8px; margin-top: 25px; border-left: 4px solid #f59e0b;">
                                <p style="margin: 0; color: #92400e; font-size: 14px;">
                                    <strong>💡 Importante:</strong> Guarda este correo de confirmación para futuras referencias.
                                    También puedes revisar tu bandeja de entrada o spam.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-secondary" @onclick="CloseQuoteModal">
                            Cerrar
                        </button>
                    </div>
                }
                else
                {
                    <!-- FORMULARIO DE COTIZACIÓN -->
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="error-message">
                                <strong>⚠️ Error:</strong><br>
                                @foreach (var line in errorMessage.Split('\n'))
                                {
                                    <span>@line</span>
                    
                                    <br>
                                }
                            </div>
                        }

                        <div style="background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%); padding: 15px; border-radius: 8px; margin-bottom: 25px; border-left: 4px solid #667eea;">
                            <p style="margin: 0; color: #1e3a8a; font-size: 15px;">
                                <strong>📋 Servicio seleccionado:</strong><br>
                                <span style="font-size: 18px; font-weight: 700; color: #667eea;">@GetServiceTitle(selectedService)</span>
                            </p>
                            <p style="margin: 10px 0 0 0; color: #1e3a8a; font-size: 14px;">
                                💰 Desde: <strong>@GetPriceRange(selectedService)</strong> |
                                ⏱️ Tiempo: <strong>@GetDeliveryTime(selectedService)</strong>
                            </p>
                        </div>

                        <EditForm Model="@quoteForm" OnValidSubmit="SubmitQuote">
                            <div class="form-group">
                                <label>Nombre completo *</label>
                                <InputText @bind-Value="quoteForm.Name" class="form-control"
                                           disabled="@isSubmitting" placeholder="Ej: Juan Pérez García" />
                                @if (showValidation && string.IsNullOrWhiteSpace(quoteForm.Name))
                                {
                                    <span class="validation-error">⚠️ El nombre es requerido</span>
                                }
                            </div>

                            <div class="form-group">
                                <label>Email *</label>
                                <InputText type="email" @bind-Value="quoteForm.Email" class="form-control"
                                           disabled="@isSubmitting" placeholder="Ej: tuempresa@ejemplo.com" />
                                @if (showValidation && string.IsNullOrWhiteSpace(quoteForm.Email))
                                {
                                    <span class="validation-error">⚠️ El email es requerido</span>
                                }
                            </div>

                            <div class="form-group">
                                <label>Teléfono (WhatsApp) *</label>
                                <InputText type="tel" @bind-Value="quoteForm.Phone" class="form-control"
                                           disabled="@isSubmitting" placeholder="Ej: 4421234567" />
                                @if (showValidation && string.IsNullOrWhiteSpace(quoteForm.Phone))
                                {
                                    <span class="validation-error">⚠️ El teléfono es requerido</span>
                                }
                            </div>

                            <div class="form-group">
                                <label>Empresa</label>
                                <InputText @bind-Value="quoteForm.Company" class="form-control"
                                           disabled="@isSubmitting" placeholder="Nombre de tu empresa (opcional)" />
                            </div>

                            <div class="form-group">
                                <label>Tamaño de Empresa</label>
                                <InputSelect @bind-Value="quoteForm.CompanySize" class="form-control" disabled="@isSubmitting">
                                    <option value="">Seleccionar...</option>
                                    <option value="1-10 empleados">1-10 empleados</option>
                                    <option value="11-50 empleados">11-50 empleados</option>
                                    <option value="51-200 empleados">51-200 empleados</option>
                                    <option value="200+ empleados">200+ empleados</option>
                                </InputSelect>
                            </div>

                            <div class="form-group">
                                <label>Prioridad de Atención</label>
                                <InputSelect @bind-Value="quoteForm.Priority" class="form-control" disabled="@isSubmitting">
                                    <option value="Media">📅 Media - Respuesta en 24-48 horas</option>
                                    <option value="Alta">⚡ Alta - Respuesta en menos de 24 horas</option>
                                    <option value="Urgente">🚨 Urgente - Contacto inmediato</option>
                                </InputSelect>
                            </div>

                            <div class="form-group">
                                <label>Cuéntanos tus necesidades *</label>
                                <InputTextArea @bind-Value="quoteForm.Message" class="form-control" rows="4"
                                               disabled="@isSubmitting"
                                               placeholder="Describe qué necesitas, plazos, presupuesto aproximado, etc." />
                                @if (showValidation && string.IsNullOrWhiteSpace(quoteForm.Message))
                                {
                                    <span class="validation-error">⚠️ El mensaje es requerido</span>
                                }
                            </div>
                        </EditForm>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-secondary" @onclick="CloseQuoteModal" disabled="@isSubmitting">
                            Cancelar
                        </button>
                        <button type="button" class="btn-primary" @onclick="SubmitQuote" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span>⏳ Enviando...</span>
                            }
                            else
                            {
                                <span>📤 Enviar Cotización</span>
                            }
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>

<footer class="footer">
   <!-- Línea inferior del copyright -->
    <div class="footer-bottom">
        <div class="footer-bottom-left">
            © 2025 Consultoría Integral SC Todos los derechos reservados.
        </div>
        <div class="footer-bottom-right">
            <a href="/terminos-condiciones" class="legal-link">Términos y Condiciones</a>
            <span class="legal-separator">•</span>
            <a href="/politicas-privacidad" class="legal-link">Políticas de Privacidad</a>
        </div>
    </div>
</footer>

@code {
    private string selectedService = "";
    private bool showContactModal = false;
    private bool showQuoteModal = false;
    private bool quoteSubmitted = false;
    private bool showValidation = false;
    private bool isSubmitting = false;
    private string errorMessage = "";
    private List<string> openFAQs = new List<string>();

    private class QuoteFormModel
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Company { get; set; } = "";
        public string CompanySize { get; set; } = "";
        public string Message { get; set; } = "";
        public string Priority { get; set; } = "Media";
    }

    private QuoteFormModel quoteForm = new QuoteFormModel();

    private void SelectService(string serviceType)
    {
        selectedService = serviceType;
        openFAQs.Clear();
    }

    private void ToggleFAQ(string question)
    {
        if (openFAQs.Contains(question))
            openFAQs.Remove(question);
        else
            openFAQs.Add(question);
    }

    private void OpenContactModal() => showContactModal = true;
    private void CloseContactModal() => showContactModal = false;

    private void OpenQuoteModal()
    {
        showQuoteModal = true;
        quoteSubmitted = false;
        showValidation = false;
        errorMessage = "";
        quoteForm = new QuoteFormModel();
    }

    private void CloseQuoteModal()
    {
        if (!isSubmitting)
        {
            showQuoteModal = false;
            quoteSubmitted = false;
            showValidation = false;
            errorMessage = "";
        }
    }

    // CÓDIGO ACTUALIZADO PARA EL MÉTODO SubmitQuote en Servicios.razor

    private async Task SubmitQuote()
    {
        showValidation = true;
        errorMessage = "";

        try
        {
            // Validaciones
            if (string.IsNullOrWhiteSpace(quoteForm.Name))
            {
                errorMessage = "El nombre es requerido";
                return;
            }

            if (string.IsNullOrWhiteSpace(quoteForm.Email))
            {
                errorMessage = "El email es requerido";
                return;
            }

            if (!quoteForm.Email.Contains("@"))
            {
                errorMessage = "El email no es válido";
                return;
            }

            if (string.IsNullOrWhiteSpace(quoteForm.Phone))
            {
                errorMessage = "El teléfono es requerido";
                return;
            }

            var telefonoLimpio = new string(quoteForm.Phone.Where(char.IsDigit).ToArray());
            if (telefonoLimpio.Length < 10)
            {
                errorMessage = "El teléfono debe tener al menos 10 dígitos";
                return;
            }

            if (string.IsNullOrWhiteSpace(quoteForm.Message))
            {
                errorMessage = "El mensaje es requerido";
                return;
            }

            isSubmitting = true;
            StateHasChanged();

            // Crear objeto con todos los campos
            var cotizacionData = new Dictionary<string, object>
        {
            { "Nombre", quoteForm.Name.Trim() },
            { "Correo", quoteForm.Email.Trim().ToLower() },
            { "Telefono", quoteForm.Phone.Trim() },
            { "NombreEmpresa", string.IsNullOrWhiteSpace(quoteForm.Company) ? null : quoteForm.Company.Trim() },
            { "TamanoEmpresa", string.IsNullOrWhiteSpace(quoteForm.CompanySize) ? null : quoteForm.CompanySize },
            { "TipoConsulta", $"Cotización: {GetServiceTitle(selectedService)}" },
            { "Prioridad", quoteForm.Priority },
            { "Mensaje", $"=== SOLICITUD DE COTIZACIÓN ===\n\n" +
                        $"📋 SERVICIO: {GetServiceTitle(selectedService)}\n" +
                        $"💰 PRECIO BASE: {GetPriceRange(selectedService)}\n" +
                        $"⏱️ TIEMPO ESTIMADO: {GetDeliveryTime(selectedService)}\n\n" +
                        $"🏢 EMPRESA: {(string.IsNullOrWhiteSpace(quoteForm.Company) ? "No especificado" : quoteForm.Company)}\n" +
                        $"👥 TAMAÑO: {(string.IsNullOrWhiteSpace(quoteForm.CompanySize) ? "No especificado" : quoteForm.CompanySize)}\n" +
                        $"⚡ PRIORIDAD: {quoteForm.Priority}\n\n" +
                        $"💬 MENSAJE DEL CLIENTE:\n{quoteForm.Message}" },
            { "Estado", "Pendiente" },
            { "UsuarioAlta", "WebClient" },
            { "UsuarioMod", "WebClient" },
            { "FechaAlta", DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss") },
            { "FechaMod", DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss") }
        };

            Console.WriteLine("=== ENVIANDO COTIZACIÓN ===");
            Console.WriteLine($"API: {Http.BaseAddress}api/Cotizacion");

            var jsonDebug = System.Text.Json.JsonSerializer.Serialize(cotizacionData);
            Console.WriteLine($"JSON COMPLETO: {jsonDebug}");

            var response = await Http.PostAsJsonAsync("api/Cotizacion", cotizacionData);

            Console.WriteLine($"Status: {response.StatusCode}");

            var responseContent = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Response: {responseContent}");

            if (response.IsSuccessStatusCode)
            {
                try
                {
                    var options = new System.Text.Json.JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true
                        };

                    var resultado = System.Text.Json.JsonSerializer.Deserialize<CotizacionResponse>(
                        responseContent, options);

                    Console.WriteLine($"✅ Éxito - Folio: {resultado?.Folio}");

                    quoteSubmitted = true;
                    showValidation = false;
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"✅ Cotización enviada (error parseando respuesta): {ex.Message}");
                    quoteSubmitted = true;
                    showValidation = false;
                }
            }
            else
            {
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(responseContent);
                    if (doc.RootElement.TryGetProperty("errors", out var errors))
                    {
                        var errorList = new List<string>();
                        foreach (var error in errors.EnumerateObject())
                        {
                            var fieldErrors = error.Value.EnumerateArray()
                                .Select(e => e.GetString())
                                .ToList();
                            errorList.Add($"• {error.Name}: {string.Join(", ", fieldErrors)}");
                        }
                        errorMessage = $"Errores de validación:\n{string.Join("\n", errorList)}";
                    }
                    else if (doc.RootElement.TryGetProperty("error", out var errorProp))
                    {
                        errorMessage = errorProp.GetString();
                    }
                    else
                    {
                        errorMessage = $"Error {response.StatusCode}";
                    }
                }
                catch
                {
                    errorMessage = $"Error {response.StatusCode}";
                }

                Console.WriteLine($"❌ Error: {errorMessage}");
                errorMessage += "\n\n💡 También puedes contactarnos por:\n📞 56-5964-4304\n💬 WhatsApp";
            }
        }
        catch (HttpRequestException httpEx)
        {
            errorMessage = "No se pudo conectar con el servidor. Verifica tu conexión a internet.";
            Console.WriteLine($"❌ Error HTTP: {httpEx.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = "Ocurrió un error inesperado. Por favor intenta nuevamente.";
            Console.WriteLine($"❌ Excepción: {ex.Message}");
            Console.WriteLine($"Stack: {ex.StackTrace}");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void OpenWhatsApp()
    {
        string phoneNumber = "5215659644304";
        string serviceTitle = GetServiceTitle(selectedService);
        string priceRange = GetPriceRange(selectedService);
        string deliveryTime = GetDeliveryTime(selectedService);

        string message = $"¡Hola! 👋\n\nMe interesa obtener más información sobre:\n📋 *{serviceTitle}*\n\nDetalles que vi:\n💰 Desde: {priceRange}\n⏱️ Tiempo: {deliveryTime}\n\n¿Podrían proporcionarme más información?";

        string whatsappUrl = $"https://wa.me/{phoneNumber}?text={Uri.EscapeDataString(message)}";
        Navigation.NavigateTo(whatsappUrl, true);
    }

    private void OpenWhatsAppQuote()
    {
        string phoneNumber = "5215659644304";
        string message = $"Hola, acabo de solicitar una cotización para {GetServiceTitle(selectedService)}. Mi nombre es {quoteForm.Name}.";
        Navigation.NavigateTo($"https://wa.me/{phoneNumber}?text={Uri.EscapeDataString(message)}", true);
    }

